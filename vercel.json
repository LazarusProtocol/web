{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api.lazarusprotocol.online/api/:path*" },
    { "source": "/static/:path*", "destination": "https://api.lazarusprotocol.online/static/:path*" },
    { "source": "/((?!assets/|api/|static/)[^.]*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
